@rendermode InteractiveServer

<div class="dropdown">
    <AuthorizeView>
        <a href="#" class="d-flex align-items-center  text-decoration-none dropdown-toggle text-black" data-bs-toggle="dropdown" aria-expanded="false">
            <img src="images/user.png" alt="" width="32" height="32" class="rounded-circle me-2">
            @context.User.Identity?.Name.Substring(0, 7)
        </a>
        <ul class="dropdown-menu text-small shadow">
            <li><NavLink class="dropdown-item" href="Account/Manage">Profile</NavLink></li>
            <li><NavLink class="dropdown-item" href="admin/dashboard">Dashboard</NavLink></li>
            <li><NavLink class="dropdown-item" href="#">Settings</NavLink></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <a class="dropdown-item text-danger" onclick="@OpenModalSingOut">
                    @* <span class="bi bi-arrow-bar-left" aria-hidden="true"></span>  *@
                    Sing Out
                </a>
            </li>
        </ul>
    </AuthorizeView>
</div>

<ModalSingOut @ref=RefModalSingOut />

@code{
    ModalSingOut RefModalSingOut;

    private async Task OpenModalSingOut()
    {
        await RefModalSingOut.OpenModal();
    }
}