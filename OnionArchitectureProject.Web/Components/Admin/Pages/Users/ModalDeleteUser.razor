@using OnionArchitectureProject.Application.Admin.UserService.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

<ModalBase @ref="modalRef">
	<div class="modal-header">
		<h5 class="modal-title" id="deleteUserModalLabel">Delete User</h5>
		<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	</div>
	<div class="modal-body">
		<p>Are you sure you want to delete user <strong>@userToDelete?.UserName</strong>?</p>
		<p class="text-danger">This action cannot be undone.</p>
	</div>
	<div class="modal-footer">
		<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
		<button type="button" class="btn btn-danger" @onclick="DeleteUser">Delete</button>
	</div>
</ModalBase>

@code {
	[Parameter]
	public EventCallback<UserDto> OnUserDeleted { get; set; }

	private ModalBase? modalRef;
	private UserDto? userToDelete { get; set; }

	public async Task OpenModalAsync(UserDto user)
	{
		userToDelete = user;
		if (modalRef != null)
		{
			await modalRef.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (modalRef != null)
		{
			await modalRef.CloseModalAsync();
		}
	}

	private async Task DeleteUser()
	{
		try
		{
			await OnUserDeleted.InvokeAsync(userToDelete);
			await CloseModalAsync();
		}
		catch (Exception ex)
		{
			Console.Error.WriteLine($"Error deleting user: {ex.Message}");
		}
	}
}