@using OnionArchitectureProject.Application.Admin.UserService.Models

<ModalDelete @ref="deleteModal" Title="Delete user" OnDeleted="HandleDeleted">
	<div class="alert alert-warning">
		<p>
			<i class="bi bi-exclamation-triangle me-2"></i>
			Are you sure you want to delete user <strong>@userToDelete.UserName</strong>?
		</p>
		<p class="mb-0 mt-2 text-muted small">This action cannot be undone.</p>
	</div>
</ModalDelete>

@code {

	[Parameter]
	public EventCallback<UserDto> OnUserDeleted { get; set; }

	private ModalDelete? deleteModal;
	private UserDto userToDelete = new();

	public async Task OpenModalAsync(UserDto user)
	{
		userToDelete = user;
		if (deleteModal != null)
		{
			await deleteModal.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (deleteModal != null)
		{
			await deleteModal.CloseModalAsync();
		}
	}

	private async Task HandleDeleted()
	{
		await OnUserDeleted.InvokeAsync(userToDelete);
	}
}