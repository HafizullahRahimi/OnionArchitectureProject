@using Blazored.FluentValidation
@using OnionArchitectureProject.Application.Admin.UserService.Models

<ModalBase @ref="modalRef">
	<EditForm Model="@createUserDto" OnValidSubmit="HandleValidSubmit">
		<FluentValidationValidator @ref="fluentValidationValidator" />
		<div class="modal-header">
			<h5 class="modal-title">
				<i class="bi bi-person-plus me-2"></i>Add New User
			</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<div class="modal-body">
			<div class="mb-3">
				<label for="userName" class="form-label">Username</label>
				<InputText @bind-Value="createUserDto.UserName" class="form-control" id="userName" />
				<ValidationMessage For="@(() => createUserDto.UserName)" class="text-danger small" />
			</div>
			<div class="mb-3">
				<label for="email" class="form-label">Email</label>
				<InputText @bind-Value="createUserDto.Email" class="form-control" id="email" />
				<ValidationMessage For="@(() => createUserDto.Email)" class="text-danger small" />
			</div>
			<div class="mb-3">
				<label for="password" class="form-label">Password</label>
				<InputText type="password" @bind-Value="createUserDto.Password" class="form-control" id="password" />
				<ValidationMessage For="@(() => createUserDto.Password)" class="text-danger small" />
				<div class="form-text">
					Password must be at least 8 characters long and contain uppercase, lowercase, number, and special
					character.
				</div>
			</div>
			<div class="mb-3">
				<label for="confirmPassword" class="form-label">Confirm Password</label>
				<InputText type="password" @bind-Value="createUserDto.ConfirmPassword" class="form-control"
					id="confirmPassword" />
				<ValidationMessage For="@(() => createUserDto.ConfirmPassword)" class="text-danger small" />
			</div>
			<div class="checkbox mb-3">
				<label class="form-label">
					<InputCheckbox @bind-Value="createUserDto.EmailConfirmed" class="darker-border-checkbox form-check-input" />
					Email confirmed
				</label>
			</div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
				<i class="bi bi-x-circle me-2"></i>Cancel
			</button>
			<button type="submit" class="btn btn-primary">
				<i class="bi bi-check-circle me-2"></i>Create
			</button>
		</div>
	</EditForm>
</ModalBase>

@code {
	[Parameter]
	public EventCallback<CreateUserDto> OnUserCreated { get; set; }

	private ModalBase? modalRef;
	private FluentValidationValidator? fluentValidationValidator;
	private CreateUserDto createUserDto = new();

	public async Task OpenModalAsync()
	{
		if (modalRef != null)
		{
			createUserDto = new CreateUserDto();
			await InvokeAsync(StateHasChanged);
			await modalRef.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (modalRef != null)
		{
			await modalRef.CloseModalAsync();
		}
	}

	private async Task HandleValidSubmit()
	{
		if (await fluentValidationValidator!.ValidateAsync())
		{
			await OnUserCreated.InvokeAsync(createUserDto);
		}
	}
}