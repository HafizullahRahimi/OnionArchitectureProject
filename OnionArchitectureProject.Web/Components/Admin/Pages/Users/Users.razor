@page "/Admin/Users"

@using OnionArchitectureProject.Application.Admin.UserService
@using OnionArchitectureProject.Application.Admin.UserService.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IUserService>

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="fs-2 text-black mb-0">Users</h1>
	<button type="button" class="btn btn-success" @onclick="OpenCreateModal">
		<i class="bi bi-plus-circle me-2"></i>Add User
	</button>
</div>

@if (isLoading)
{
	<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
		<Spinner />
	</div>
}
else if (error != null)
{
	<div class="alert alert-danger" role="alert">
		<i class="bi bi-exclamation-triangle me-2"></i>@error
	</div>
}
else if (!users?.Any() ?? true)
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle me-2"></i>No users available.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover caption-top">
			<thead>
				<tr>
					<th>Username</th>
					<th>Created (Local Time)</th>
					<th>Created By</th>
					<th>Modified (Local Time)</th>
					<th>Modified By</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<Virtualize Items="@users" Context="user">
					<tr>
						<td>@user.UserName</td>
						<td>@user.CreatedLocalTime.ToString("g")</td>
						<td>@user.CreatedByUserName</td>
						@if (user.ModifiedLocalTime != DateTime.MinValue)
						{
							<td>@user.ModifiedLocalTime.ToString("g")</td>
							<td>@user.ModifiedByUserName</td>
						}
						else
						{
							<td>-</td>
							<td>-</td>
						}
						<td>
							<span class="badge @(user.EmailConfirmed ? "bg-success" : "bg-warning")">
								@(user.EmailConfirmed ? "Confirmed" : "Pending")
							</span>
						</td>
						<td>
							<button type="button" class="btn btn-sm btn-primary me-2"
								@onclick="() => OpenUpdateModal(user)">
								<i class="bi bi-pencil"></i>
							</button>
						</td>
					</tr>
				</Virtualize>
			</tbody>
		</table>
	</div>
}

<ModalCreateUser @ref="modalCreateUserRef" OnUserCreated="HandleUserCreated" />
<ModalUpdateUser @ref="modalUpdateUserRef" OnUserUpdated="HandleUserUpdated" />
<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
	private List<UserDto>? users;
	private ModalCreateUser? modalCreateUserRef;
	private ModalUpdateUser? modalUpdateUserRef;
	private SweetAlert? sweetAlertRef;
	private bool isLoading;
	private string? error;

	protected override async Task OnInitializedAsync()
	{
		await LoadUsersAsync();
	}

	private async Task OpenCreateModal()
	{
		if (modalCreateUserRef != null)
		{
			await modalCreateUserRef.OpenModalAsync();
		}
	}

	private async Task CloseCreateModal()
	{
		if (modalCreateUserRef != null)
		{
			await modalCreateUserRef.CloseModalAsync();
		}
	}

	private async Task OpenUpdateModal(UserDto user)
	{
		if (modalUpdateUserRef != null)
		{
			await modalUpdateUserRef.OpenModalAsync(user);
		}
	}

	private async Task CloseUpdateModal()
	{
		if (modalUpdateUserRef != null)
		{
			await modalUpdateUserRef.CloseModalAsync();
		}
	}

	private async Task HandleUserCreated(CreateUserDto createUserDto)
	{
		try
		{
			isLoading = true;
			StateHasChanged();

			var result = await Service.CreateAsync(createUserDto);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await CloseCreateModal();
					await LoadUsersAsync();
				}, "User created successfully!");
			}
			else
			{
				await ShowAlertAsync($"Error creating user: {result.Error}", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error creating user: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserUpdated(UpdateUserDto updateUserDto)
	{
		try
		{
			isLoading = true;
			StateHasChanged();

			var result = await Service.UpdateAsync(updateUserDto);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await CloseUpdateModal();
					await LoadUsersAsync();
				}, "User updated successfully!");
			}
			else
			{
				await ShowAlertAsync($"Error updating user: {result.Error}", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error updating user: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserOperationAsync(Func<Task> operation, string successMessage)
	{
		try
		{
			await operation();
			await ShowAlertAsync(successMessage, SweetAlertIcon.Success);
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Operation failed: {ex.Message}", SweetAlertIcon.Error);
		}
	}

	private async Task LoadUsersAsync()
	{
		try
		{
			isLoading = true;
			error = null;
			StateHasChanged();

			users = await Service.GetUsersAsync();
		}
		catch (Exception ex)
		{
			error = $"Failed to load users: {ex.Message}";
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
	{
		if (sweetAlertRef != null)
		{
			await sweetAlertRef.ShowAlertAsync(text, icon);
		}
	}
}