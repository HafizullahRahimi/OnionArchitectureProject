@page "/Admin/Users"

@using OnionArchitectureProject.Application.Admin.UserService
@using OnionArchitectureProject.Application.Admin.UserService.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IUserService>

<PageTitle>Users Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="fs-2 text-black mb-0">Users Management</h1>
	<button type="button" class="btn btn-success" @onclick="OpenModalUpsert">
		<i class="bi bi-plus-circle me-2"></i>Add User
	</button>
</div>

@if (isLoading)
{
	<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
		<Spinner />
	</div>
}
else if (error != null)
{
	<div class="alert alert-danger" role="alert">
		<i class="bi bi-exclamation-triangle me-2"></i>@error
	</div>
}
else if (!users?.Any() ?? true)
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle me-2"></i>No users available. Click the "Add user" button to create one.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover caption-top">
			<thead>
				<tr>
					<th>Username</th>
					<th>Created (Local Time)</th>
					<th>Created By</th>
					<th>Modified (Local Time)</th>
					<th>Modified By</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<Virtualize Items="@users" Context="user">
					<tr>
						<td>@user.UserName</td>
						<td>@user.CreatedLocalTime.ToString("g")</td>
						<td>@user.CreatedByUserName</td>
						@if (user.ModifiedLocalTime != DateTime.MinValue)
						{
							<td>@user.ModifiedLocalTime.ToString("g")</td>
							<td>@user.ModifiedByUserName</td>
						}
						else
						{
							<td>-</td>
							<td>-</td>
						}
						<td>
							<span class="badge @(user.EmailConfirmed ? "bg-success" : "bg-warning")">
								@(user.EmailConfirmed ? "Confirmed" : "Pending")
							</span>
						</td>
						<td>
							<button type="button" class="btn btn-sm btn-primary me-2"
									@onclick="() => OpenModalUpsert(user)">
								<i class="bi bi-pencil"></i>
							</button>
							<button type="button" class="btn btn-sm btn-info me-2" @onclick="() => OpenModalManageUserRoles(user)">
								<i class="bi bi-person-gear"></i>
							</button>
							<button type="button" class="btn btn-sm btn-danger" @onclick="() => OpenModalDelete(user)">
								<i class="bi bi-trash"></i>
							</button>
						</td>
					</tr>
				</Virtualize>
			</tbody>
		</table>
	</div>
}

<ModalUpsertUser @ref="modalUpsertUserRef" OnUserCreated="HandleUserCreated" OnUserUpdated="HandleUserUpdated" />
<ModalDeleteUser @ref="modalDeleteUserRef" OnUserDeleted="HandleUserDeleted" />
<ModalManageUserRoles @ref="modalManageUserRolesRef" OnUserRolesUpdated="HandleUserRolesUpdated" />
<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
	private List<UserDto>? users;
	private ModalUpsertUser? modalUpsertUserRef;
	private ModalDeleteUser? modalDeleteUserRef;
	private ModalManageUserRoles? modalManageUserRolesRef;
	private SweetAlert? sweetAlertRef;
	private bool isLoading;
	private string? error;

	protected override async Task OnInitializedAsync()
	{
		await LoadUsersAsync();
	}

	private async Task OpenModalUpsert()
	{
		if (modalUpsertUserRef != null)
		{
			await modalUpsertUserRef.OpenModalAsync();
		}
	}

	private async Task OpenModalUpsert(UserDto userDto)
	{
		if (modalUpsertUserRef != null)
		{
			var upsertUserDto = Service.MapToUpsertUserDto(userDto);

			if (upsertUserDto != null)
			{
				await modalUpsertUserRef.OpenModalAsync(upsertUserDto);
			}
		}
	}

	private async Task CloseModalUpsert()
	{
		if (modalUpsertUserRef != null)
		{
			await modalUpsertUserRef.CloseModalAsync();
		}
	}

	private async Task OpenModalDelete(UserDto userDto)
	{
		if (modalDeleteUserRef != null)
		{
			await modalDeleteUserRef.OpenModalAsync(userDto);
		}
	}

	private async Task OpenModalManageUserRoles(UserDto userDto)
	{
		var userRoles = await Service.GetUserRolesAsync(userDto.Id);
		if (modalManageUserRolesRef != null)
		{
			await modalManageUserRolesRef.OpenModalAsync(userRoles);
		}
	}

	private async Task CloseModalManageUserRoles()
	{
		if (modalManageUserRolesRef != null)
		{
			await modalManageUserRolesRef.CloseModalAsync();
		}
	}

	private async Task HandleUserCreated(UpsertUserDto upsertUserDto)
	{
		try
		{
			isLoading = true;

			var result = await Service.CreateAsync(upsertUserDto);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await CloseModalUpsert();
					await LoadUsersAsync();
				}, "User created successfully!");
			}
			else
			{
				await ShowAlertAsync($"Error creating user: {result.Error}", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error creating user: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserUpdated(UpsertUserDto upsertUserDto)
	{
		try
		{
			isLoading = true;

			var result = await Service.UpdateAsync(upsertUserDto);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await CloseModalUpsert();
					await LoadUsersAsync();
				}, "User updated successfully!");
			}
			else
			{
				await ShowAlertAsync($"Error updating user: {result.Error}", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error updating user: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserDeleted(UserDto userDto)
	{
		try
		{
			isLoading = true;

			var result = await Service.DeleteAsync(userDto.Id);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await LoadUsersAsync();
				}, "User deleted successfully!");
			}
			else
			{
				await ShowAlertAsync($"Error deleting user: {result.Error}", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error deleting user: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserRolesUpdated(UserRoleAssignmentDto userRoleAssignmentDto)
	{
		try
		{
			isLoading = true;

			var result = await Service.UpdateUserRolesAsync(userRoleAssignmentDto);
			if (result.Succeeded)
			{
				await HandleUserOperationAsync(async () =>
				{
					await CloseModalManageUserRoles();
					await LoadUsersAsync();
				}, "User roles updated successfully!");
			}
			else
			{
				await ShowAlertAsync("Failed to update user roles.", SweetAlertIcon.Error);
			}
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Error updating user roles: {ex.Message}", SweetAlertIcon.Error);
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleUserOperationAsync(Func<Task> operation, string successMessage)
	{
		try
		{
			await operation();
			await ShowAlertAsync(successMessage, SweetAlertIcon.Success);
		}
		catch (Exception ex)
		{
			await ShowAlertAsync($"Operation failed: {ex.Message}", SweetAlertIcon.Error);
		}
	}

	private async Task LoadUsersAsync()
	{
		try
		{
			isLoading = true;
			error = null;
			StateHasChanged();

			users = await Service.GetUsersAsync();
		}
		catch (Exception ex)
		{
			error = $"Failed to load users: {ex.Message}";
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
	{
		if (sweetAlertRef != null)
		{
			await sweetAlertRef.ShowAlertAsync(text, icon);
		}
	}
}