@page "/Admin/Users"

@using OnionArchitectureProject.Application.Admin.UserService
@using OnionArchitectureProject.Application.Admin.UserService.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IUserService>

<PageTitle>Users Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="fs-2 text-black mb-0">Users Management</h1>
	<button type="button" class="btn btn-success" @onclick="OpenUpsertModalAsync">
		<i class="bi bi-plus-circle me-2"></i>Add User
	</button>
</div>

@if (users == null)
{
	<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
		<Spinner />
	</div>
}
else if (!users.Any())
{
	<div class="alert alert-info" role="alert">
		<p>
			<i class="bi bi-info-circle me-2"></i>
			No users available. Click the "Add user" button to create one.
		</p>
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover caption-top">
			<thead>
				<tr>
					<th>Username</th>
					<th>Created</th>
					<th>Created By</th>
					<th>Modified</th>
					<th>Modified By</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<Virtualize Items="@users" Context="user">
					<tr>
						<td>@user.UserName</td>
						<td>@user.CreatedLocalTime.ToString("g")</td>
						<td>@user.CreatedByUserName</td>
						@if (user.ModifiedLocalTime != DateTime.MinValue)
						{
							<td>@user.ModifiedLocalTime.ToString("g")</td>
							<td>@user.ModifiedByUserName</td>
						}
						else
						{
							<td>-</td>
							<td>-</td>
						}
						<td>
							<span class="badge @(user.EmailConfirmed ? "bg-success" : "bg-warning")">
								@(user.EmailConfirmed ? "Confirmed" : "Pending")
							</span>
						</td>
						<td>
							<button type="button" class="btn btn-sm btn-primary me-2"
									@onclick="() => OpenUpsertModalAsync(user)">
								<i class="bi bi-pencil"></i>
							</button>
							<button type="button" class="btn btn-sm btn-info me-2" @onclick="() => OpenManageUserRolesModalAsync(user)">
								<i class="bi bi-person-gear"></i>
							</button>
							<button type="button" class="btn btn-sm btn-danger" @onclick="() => OpenDeleteModalAsync(user)">
								<i class="bi bi-trash"></i>
							</button>
						</td>
					</tr>
				</Virtualize>
			</tbody>
		</table>
	</div>
}

<ModalUpsertUser @ref="modalUpsertUserRef" OnUserCreated="HandleUserCreated" OnUserUpdated="HandleUserUpdated" />
<ModalDeleteUser @ref="modalDeleteUserRef" OnUserDeleted="HandleUserDeleted" />
<ModalManageUserRoles @ref="modalManageUserRolesRef" OnUserRolesUpdated="HandleUserRolesUpdated" />
<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
	private List<UserDto>? users;
	private ModalUpsertUser? modalUpsertUserRef;
	private ModalDeleteUser? modalDeleteUserRef;
	private ModalManageUserRoles? modalManageUserRolesRef;
	private SweetAlert? sweetAlertRef;

	protected override async Task OnInitializedAsync()
	{
		await LoadUsersAsync();
	}

	private async Task OpenUpsertModalAsync()
	{
		if (modalUpsertUserRef != null)
		{
			await modalUpsertUserRef.OpenModalAsync();
		}
	}

	private async Task OpenUpsertModalAsync(UserDto userDto)
	{
		if (modalUpsertUserRef != null)
		{
			var upsertUserDto = Service.MapToUpsertUserDto(userDto);

			if (upsertUserDto != null)
			{
				await modalUpsertUserRef.OpenModalAsync(upsertUserDto);
			}
		}
	}

	private async Task CloseUpsertModalAsync()
	{
		if (modalUpsertUserRef != null)
		{
			await modalUpsertUserRef.CloseModalAsync();
		}
	}

	private async Task OpenDeleteModalAsync(UserDto userDto)
	{
		if (modalDeleteUserRef != null)
		{
			await modalDeleteUserRef.OpenModalAsync(userDto);
		}
	}

	private async Task CloseDeleteModalAsync()
	{
		if (modalDeleteUserRef != null)
		{
			await modalDeleteUserRef.CloseModalAsync();
		}
	}

	private async Task OpenManageUserRolesModalAsync(UserDto userDto)
	{
		var userRoles = await Service.GetUserRolesAsync(userDto.Id);
		if (modalManageUserRolesRef != null)
		{
			await modalManageUserRolesRef.OpenModalAsync(userRoles);
		}
	}

	private async Task CloseManageUserRolesModalAsync()
	{
		if (modalManageUserRolesRef != null)
		{
			await modalManageUserRolesRef.CloseModalAsync();
		}
	}

	private async Task HandleUserCreated(UpsertUserDto upsertUserDto)
	{
		var result = await Service.CreateAsync(upsertUserDto);
		if (result.Succeeded)
		{
			await HandleUserOperationAsync(async () =>
			{
				await LoadUsersAsync();
				await CloseUpsertModalAsync();
			}, $"User '{upsertUserDto.UserName}' created successfully!");
		}
		else
		{
			await ShowAlertAsync($"An error occurred while creating the user.", SweetAlertIcon.Error);
		}
	}

	private async Task HandleUserUpdated(UpsertUserDto upsertUserDto)
	{
		var result = await Service.UpdateAsync(upsertUserDto);
		if (result.Succeeded)
		{
			await HandleUserOperationAsync(async () =>
			{
				await LoadUsersAsync();
				await CloseUpsertModalAsync();
			}, $"User '{upsertUserDto.UserName}' updated successfully!");
		}
		else
		{
			await ShowAlertAsync($"An error occurred while updating the user.", SweetAlertIcon.Error);
		}
	}

	private async Task HandleUserDeleted(UserDto user)
	{
		var result = await Service.DeleteAsync(user.Id);
		if (result.Succeeded)
		{
			await HandleUserOperationAsync(async () =>
			{
				await LoadUsersAsync();
				await CloseDeleteModalAsync();
			}, $"User '{user.UserName}' deleted successfully!");
		}
		else
		{
			await ShowAlertAsync($"An error occurred while deleting the user.", SweetAlertIcon.Error);
		}
	}

	private async Task HandleUserRolesUpdated(UserRoleAssignmentDto userRoleAssignmentDto)
	{
		var result = await Service.UpdateUserRolesAsync(userRoleAssignmentDto);
		if (result.Succeeded)
		{
			await HandleUserOperationAsync(async () =>
			{
				await LoadUsersAsync();
				await CloseManageUserRolesModalAsync();
			}, "User roles updated successfully!");
		}
		else
		{
			await ShowAlertAsync($"An error occurred while updating the user roles.", SweetAlertIcon.Error);
		}
	}

	private async Task HandleUserOperationAsync(Func<Task> operation, string successMessage)
	{
		await operation();
		await InvokeAsync(StateHasChanged);
		await ShowAlertAsync(successMessage, SweetAlertIcon.Success);
	}

	private async Task LoadUsersAsync()
	{
		users = await Service.GetUsersAsync();
	}

	private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
	{
		if (sweetAlertRef != null)
		{
			await sweetAlertRef.ShowAlertAsync(text, icon);
		}
	}
}