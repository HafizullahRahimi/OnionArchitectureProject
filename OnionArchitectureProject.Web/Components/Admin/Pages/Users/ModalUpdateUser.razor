@using OnionArchitectureProject.Application.Admin.UserService.Models

<ModalBase @ref="modalRef">
	<EditForm Model="@UpdateUserDto" OnValidSubmit="HandleValidSubmit">
		<FluentValidationValidator @ref="fluentValidationValidator" />
		<div class="modal-header">
			<h5 class="modal-title" id="updateUserModalLabel">Update User</h5>
			<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
		</div>
		<div class="modal-body">
			<div class="mb-3">
				<label for="userName" class="form-label">Username</label>
				<InputText id="userName" @bind-Value="UpdateUserDto.UserName" class="form-control" />
				<ValidationMessage For="@(() => UpdateUserDto.UserName)" />
			</div>
			<div class="mb-3">
				<label for="email" class="form-label">Email</label>
				<InputText id="email" @bind-Value="UpdateUserDto.Email" class="form-control" />
				<ValidationMessage For="@(() => UpdateUserDto.Email)" />
			</div>
			<div class="mb-3">
				<label for="password" class="form-label">New Password (Optional)</label>
				<InputText id="password" @bind-Value="UpdateUserDto.Password" type="password" class="form-control" />
				<ValidationMessage For="@(() => UpdateUserDto.Password)" />
				<div class="form-text">
					Password must be at least 8 characters long and contain uppercase, lowercase, number, and special character.
				</div>
			</div>
			<div class="mb-3">
				<label for="confirmPassword" class="form-label">Confirm Password</label>
				<InputText id="confirmPassword" type="password" @bind-Value="UpdateUserDto.ConfirmPassword" class="form-control" />
				<ValidationMessage For="@(() => UpdateUserDto.ConfirmPassword)" class="text-danger small" />
			</div>
			<div class="mb-3">
				<div class="form-check">
					<InputCheckbox id="emailConfirmed" @bind-Value="UpdateUserDto.EmailConfirmed" class="form-check-input" />
					<label class="form-check-label" for="emailConfirmed">Email Confirmed</label>
				</div>
			</div>
		</div>
		<div class="modal-footer">
			<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
			<button type="submit" class="btn btn-primary" disabled="@isSubmitting">
				@if (isSubmitting)
				{
					<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
					<span class="ms-2">Updating...</span>
				}
				else
				{
					<span>Update User</span>
				}
			</button>
		</div>
	</EditForm>
</ModalBase>


@code {
	[Parameter]
	public EventCallback<UpdateUserDto> OnUserUpdated { get; set; }

	private ModalBase? modalRef;
	private FluentValidationValidator? fluentValidationValidator;
	private UpdateUserDto UpdateUserDto { get; set; } = new();
	private bool isSubmitting;
	private EditContext? editContext;
	private ValidationMessageStore? messageStore;

	protected override void OnInitialized()
	{
		editContext = new EditContext(UpdateUserDto);
		messageStore = new ValidationMessageStore(editContext);
	}

	public async Task OpenModalAsync(UserDto user)
	{
		UpdateUserDto = new UpdateUserDto
			{
				Id = user.Id,
				UserName = user.UserName,
				Email = user.Email,
				EmailConfirmed = user.EmailConfirmed
			};

		editContext = new EditContext(UpdateUserDto);
		messageStore = new ValidationMessageStore(editContext);
		if (modalRef != null)
		{
			await modalRef.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (modalRef != null)
		{
			await modalRef.CloseModalAsync();
		}
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			isSubmitting = true;

			if (await fluentValidationValidator!.ValidateAsync())
			{
				await OnUserUpdated.InvokeAsync(UpdateUserDto);
			}

		}
		finally
		{
			isSubmitting = false;
		}
	}

}