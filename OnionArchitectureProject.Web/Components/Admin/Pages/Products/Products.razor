@page "/Admin/Products"

@using OnionArchitectureProject.Application.Admin.ProductService
@using OnionArchitectureProject.Application.Admin.ProductService.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IProductService>
@inject ILogger<Products> Logger

<PageTitle>Products Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="fs-2 text-black mb-0">Products Management</h1>
	<button type="button" class="btn btn-success">
		<i class="bi bi-plus-circle me-2"></i>Add product
	</button>
</div>

@if (isLoading)
{
	<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
		<Spinner />
	</div>
}
else if (error != null)
{
	<div class="alert alert-danger" role="alert">
		<i class="bi bi-exclamation-triangle me-2"></i>@error
	</div>
}
else if (!products?.Any() ?? true)
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle me-2"></i> No products available. Click the "Add product" button to create one.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover caption-top">
			<thead>
				<tr>
					<th>Name</th>
					<th>Category</th>
					<th>Created (Local Time)</th>
					<th>Created By</th>
					<th>Modified (Local Time)</th>
					<th>Modified By</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<Virtualize Items="@products" Context="product">
					<tr>
						<td>@product.Name</td>
						<td>@product.Category.Name</td>
						<td>@product.CreatedLocalTime</td>
						<td>@product.CreatedBy.UserName</td>
						@if (product.ModifiedBy != null)
						{
							<td>@product.ModifiedLocalTime.ToString("g")</td>
							<td>@product.ModifiedBy.UserName</td>
						}
						else
						{
							<td>-</td>
							<td>-</td>
						}
						<td>
							<button type="button" class="btn btn-sm btn-primary me-2">
								<i class="bi bi-pencil"></i>
							</button>
							<button type="button" class="btn btn-sm btn-danger">
								<i class="bi bi-trash"></i>
							</button>
						</td>
					</tr>
				</Virtualize>
			</tbody>
		</table>
	</div>
}


<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
	private List<ProductDto>? products;
	private SweetAlert? sweetAlertRef;
	private bool isLoading;
	private string? error;

	protected override async Task OnInitializedAsync()
	{
		await LoadProductsAsync();
	}

	private async Task LoadProductsAsync()
	{
		try
		{
			isLoading = true;
			error = null;
			StateHasChanged();

			products = await Service.GetProductsAsync(CancellationToken.None);
		}
		catch (Exception ex)
		{
			error = $"Failed to load products: {ex.Message}";
		}
		finally
		{
			isLoading = false;
			StateHasChanged();
		}
	}

	private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
	{
		if (sweetAlertRef != null)
		{
			await sweetAlertRef.ShowAlertAsync(text, icon);
		}
	}
}
