@page "/Admin/Products"

@using OnionArchitectureProject.Application.Admin.ProductService
@using OnionArchitectureProject.Application.Admin.ProductService.Models
@using OnionArchitectureProject.Domain.Categories
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IProductService>
@inject ILogger<Products> Logger

<PageTitle>Products Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
	<h1 class="fs-2 text-black mb-0">Products Management</h1>
	<button type="button" class="btn btn-success" @onclick="OpenModalUpsert">
		<i class="bi bi-plus-circle me-2"></i>Add product
	</button>
</div>

@if (products == null)
{
	<div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
		<Spinner />
	</div>
}
else if (!products?.Any() ?? true)
{
	<div class="alert alert-info" role="alert">
		<i class="bi bi-info-circle me-2"></i> No products available. Click the "Add product" button to create one.
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-striped table-hover caption-top">
			<thead>
				<tr>
					<th>Name</th>
					<th>Category</th>
					<th>Price</th>
					<th>Created (Local Time)</th>
					<th>Created By</th>
					@* <th>Modified (Local Time)</th> *@
					<th>Modified By</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				<Virtualize Items="@products" Context="product">
					<tr>
						<td>@product.Name</td>
						<td>@product.Category.Name</td>
						<td>@product.Price.ToString("C2")</td>
						<td>@product.CreatedLocalTime.ToString("g")</td>
						<td>@product.CreatedBy.UserName</td>
						@if (product.ModifiedBy != null)
						{
							@* <td>@product.ModifiedLocalTime.ToString("g")</td> *@
							<td>@product.ModifiedBy.UserName</td>
						}
						else
						{
							@* <td>-</td> *@
							<td>-</td>
						}
						<td>
							<button type="button" class="btn btn-sm btn-primary me-2"
								@onclick="() => OpenModalUpsert(product)">
								<i class="bi bi-pencil"></i>
							</button>
							<button type="button" class="btn btn-sm btn-info me-2">
								<i class="bi bi-person-gear"></i>
							</button>
							<button type="button" class="btn btn-sm btn-danger" @onclick="() => OpenModalDelete(product)">
								<i class="bi bi-trash"></i>
							</button>
						</td>
					</tr>
				</Virtualize>
			</tbody>
		</table>
	</div>
}

<ModalUpsertProduct @ref="modalUpsertProductRef" OnUserCreated="HandleUserCreated" OnUserUpdated="HandleUserUpdated" />
<ModalDeleteProduct @ref="modalDeleteProductRef" OnProductDeleted="HandleProductDeleted" />
<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
	private List<ProductDto>? products;
	private List<Category>? categories;
	private ModalUpsertProduct? modalUpsertProductRef;
	private ModalDeleteProduct? modalDeleteProductRef;
	private SweetAlert? sweetAlertRef;

	protected override async Task OnInitializedAsync()
	{
		categories = await Service.GetAvailableCategoriesAsync(CancellationToken.None);
		await LoadProductsAsync();
	}


	private async Task OpenModalUpsert()
	{
		if (modalUpsertProductRef != null)
		{
			await modalUpsertProductRef.OpenModalAsync(categories);
		}
	}

	private async Task OpenModalUpsert(ProductDto productDto)
	{
		if (modalUpsertProductRef != null)
		{
			var upsertProductDto = Service.MapToUpsertProductDto(productDto);

			if (upsertProductDto != null)
			{
				await modalUpsertProductRef.OpenModalAsync(categories, upsertProductDto);
			}
		}
	}

	private async Task CloseModalUpsert()
	{
		if (modalUpsertProductRef != null)
		{
			await modalUpsertProductRef.CloseModalAsync();
		}
	}

	private async Task OpenModalDelete(ProductDto productDto)
	{
		if (modalDeleteProductRef != null)
		{
			await modalDeleteProductRef.OpenModalAsync(productDto);
		}
	}

	private async Task CloseModalDelete()
	{
		if (modalDeleteProductRef != null)
		{
			await modalDeleteProductRef.CloseModalAsync();
		}
	}

	private async Task HandleUserCreated(UpsertProductDto upsertProductDto)
	{
		var result = await Service.CreateAsync(upsertProductDto, CancellationToken.None);
		if (result.Succeeded)
		{
			await HandleProductOperationAsync(async () =>
			{
				await CloseModalUpsert();
				await LoadProductsAsync();
			}, "Product created successfully!");
		}
		else
		{
			await ShowAlertAsync($"Error creating product", SweetAlertIcon.Error);
		}
	}

	private async Task HandleUserUpdated(UpsertProductDto upsertProductDto)
	{
		var result = await Service.UpdateAsync(upsertProductDto, CancellationToken.None);
		if (result.Succeeded)
		{
			await HandleProductOperationAsync(async () =>
			{
				await CloseModalUpsert();
				await LoadProductsAsync();
			}, "Product updated successfully!");
		}
		else
		{
			await ShowAlertAsync($"Error updating product", SweetAlertIcon.Error);
		}
	}

	private async Task HandleProductDeleted(ProductDto productDto)
	{
		var result = await Service.DeleteAsync(productDto.Id, CancellationToken.None);
		if (result.Succeeded)
		{
			await HandleProductOperationAsync(async () =>
			{
				await CloseModalDelete();
				await LoadProductsAsync();
			}, "Product deleted successfully!");
		}
		else
		{
			await ShowAlertAsync($"Error deleting product", SweetAlertIcon.Error);
		}
	}

	private async Task HandleProductOperationAsync(Func<Task> operation, string successMessage)
	{
		await operation();
		await ShowAlertAsync(successMessage, SweetAlertIcon.Success);
	}

	private async Task LoadProductsAsync()
	{
		products = await Service.GetProductsAsync(CancellationToken.None);
		StateHasChanged();
	}

	private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
	{
		if (sweetAlertRef != null)
		{
			await sweetAlertRef.ShowAlertAsync(text, icon);
		}
	}
}
