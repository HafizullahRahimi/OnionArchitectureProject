@using OnionArchitectureProject.Application.Admin.ProductService.Models

<ModalBase @ref="modalRef">
	<div class="modal-header">
		<h5 class="modal-title" id="deleteProductModalLabel">Delete Product</h5>
		<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
	</div>
	<div class="modal-body">
		<p>Are you sure you want to delete product <strong>@productToDelete?.Name</strong>?</p>
		<p class="text-danger">This action cannot be undone.</p>
	</div>
	<div class="modal-footer">
		<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
		@if (isLoading)
		{
			<button type="button" class="btn btn-danger" disabled>
				<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
				Deleting...
			</button>
		}
		else
		{
			<button type="button" class="btn btn-danger" @onclick="DeleteProduct">Delete</button>
		}
	</div>
</ModalBase>

@code {
	[Parameter]
	public EventCallback<ProductDto> OnProductDeleted { get; set; }

	private ModalBase? modalRef;
	private ProductDto? productToDelete { get; set; }
	private bool isLoading { get; set; }

	public async Task OpenModalAsync(ProductDto product)
	{
		productToDelete = product;
		if (modalRef != null)
		{
			await modalRef.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		isLoading = false;
		if (modalRef != null)
		{
			await modalRef.CloseModalAsync();
		}
	}

	private async Task DeleteProduct()
	{
		isLoading = true;
		await OnProductDeleted.InvokeAsync(productToDelete);
		await CloseModalAsync();
	}
}