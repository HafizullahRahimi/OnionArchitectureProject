@using OnionArchitectureProject.Application.Admin.ProductService.Models

<ModalDelete @ref="deleteModal" Title="Delete product" OnDeleted="HandleDeleted">
	<div class="alert alert-warning">
		<p>
			<i class="bi bi-exclamation-triangle me-2"></i>
			Are you sure you want to delete product <strong>@productToDelete.Name</strong>?
		</p>
		<p class="mb-0 mt-2 text-muted small">This action cannot be undone.</p>
	</div>
</ModalDelete>

@code {
	[Parameter]
	public EventCallback<ProductDto> OnProductDeleted { get; set; }

	private ModalDelete? deleteModal;
	private ProductDto productToDelete = new();

	public async Task OpenModalAsync(ProductDto product)
	{
		productToDelete = product;
		if (deleteModal != null)
		{
			await deleteModal.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (deleteModal != null)
		{
			await deleteModal.CloseModalAsync();
		}
	}

	private async Task HandleDeleted()
	{
		await OnProductDeleted.InvokeAsync(productToDelete);
	}
}