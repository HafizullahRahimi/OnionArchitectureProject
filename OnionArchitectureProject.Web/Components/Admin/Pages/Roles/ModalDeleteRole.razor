@using OnionArchitectureProject.Application.Admin.RoleService.Models

<ModalDelete @ref="deleteModal" Title="Delete role" OnDeleted="HandleDeleted">
	<div class="alert alert-warning">
		<p>
			<i class="bi bi-exclamation-triangle me-2"></i>
			Are you sure you want to delete role <strong>@roleToDelete.Name</strong>?
		</p>
		<p class="mb-0 mt-2 text-muted small">This action cannot be undone.</p>
	</div>
</ModalDelete>

@code {
	[Parameter]
	public EventCallback<RoleDto> OnRoleDeleted { get; set; }

	private ModalDelete? deleteModal;
	private RoleDto roleToDelete = new();

	public async Task OpenModalAsync(RoleDto role)
	{
		roleToDelete = role;
		if (deleteModal != null)
		{
			await deleteModal.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (deleteModal != null)
		{
			await deleteModal.CloseModalAsync();
		}
	}

	private async Task HandleDeleted()
	{
		await OnRoleDeleted.InvokeAsync(roleToDelete);
	}
}