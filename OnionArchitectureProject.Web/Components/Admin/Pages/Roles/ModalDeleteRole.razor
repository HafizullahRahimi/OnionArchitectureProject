@using OnionArchitectureProject.Application.Admin.ApplicationRoleService.Models

<ModalBase @ref="modalRef">
    <div class="modal-header">
        <h1 class="modal-title fs-5">Delete role</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        Are you sure you want to delete the role: <strong>@roleToDelete.Name</strong>?
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="DeleteRole">Delete</button>
    </div>
</ModalBase>

@code {
    [Parameter]
    public EventCallback<RoleDto> OnRoleDeleted { get; set; }

    private ModalBase? modalRef;
    private RoleDto roleToDelete = new();

    public async Task OpenModalAsync(RoleDto role)
    {
        if (modalRef != null)
        {
            roleToDelete = role;
            await InvokeAsync(StateHasChanged);
            await modalRef.OpenModalAsync();
        }
    }

    public async Task CloseModalAsync()
    {
        if (modalRef != null)
        {
            await modalRef.CloseModalAsync();
        }
    }

    private async Task DeleteRole()
    {
        if (roleToDelete != null)
        {
            await OnRoleDeleted.InvokeAsync(roleToDelete);
        }
    }
}