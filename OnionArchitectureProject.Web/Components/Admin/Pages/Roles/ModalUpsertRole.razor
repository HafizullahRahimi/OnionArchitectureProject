@using OnionArchitectureProject.Application.Admin.ApplicationRoleService.Models.UpsertRoleDto

<ModalBase @ref=modalRef>
    <EditForm Model="@formModel" Enhance=true OnValidSubmit="OnSubmitForm">
        <div class="modal-header">
            <h5 class="modal-title">@((modalMode == "add") ? "Add role" : "Edit role")</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <FluentValidationValidator @ref="_fluentValidationValidator" />
            <ValidationSummary />
            <div class="mt-2">
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="formModel.Name" class="form-control" />
                <ValidationMessage For="@(()=>formModel.Name)"></ValidationMessage>
            </div>
            <div class="">
                <label for="description" class="form-label">Description:</label>
                <InputText id="description" @bind-Value="formModel.Description" class="form-control" />
                <ValidationMessage For="@(()=>formModel.Description)"></ValidationMessage>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            @if (isLoading)
            {
                <Spinner Title="Saving" TextColor="text-light" BgColor="bg-success" />
            }
            else
            {
                <button type="submit" class="btn btn-success ">Save</button>
            }
        </div>
    </EditForm>
</ModalBase>

@code {
    [Parameter]
    public EventCallback<UpsertRoleDto> OnRoleCreated { get; set; }
    [Parameter]
    public EventCallback<(string, UpsertRoleDto)> OnRoleUpdated { get; set; }

    private ModalBase? modalRef;
    private UpsertRoleDto formModel = new();
    private string modalMode = "add";
    private FluentValidationValidator? _fluentValidationValidator;
    private bool isLoading = false;
    private string? roleId { get; set; }

    public async Task OpenModalAsync()
    {
        modalMode = "add";
        formModel = new();
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync();
        }
    }

    public async Task OpenModalAsync(string roleId, UpsertRoleDto upsertRoleDto)
    {
        this.roleId = roleId;
        modalMode = "update";
        formModel = upsertRoleDto;
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync();
        }
    }

    public async Task CloseModalAsync()
    {
        StopLoading();
        if (modalRef != null)
        {
            roleId = null;
            await modalRef.CloseModalAsync();
        }
    }

    private async Task OnSubmitForm(){
        StartLoading();
        try
        {
            if (await _fluentValidationValidator!.ValidateAsync())
            {
                if (modalMode == "add")
                {
                    await OnRoleCreated.InvokeAsync(formModel);
                }
                else if (modalMode == "update" && roleId != null)
                {
                    await OnRoleUpdated.InvokeAsync((roleId, formModel));
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error during form submission: {ex.Message}");
        }
        finally
        {
            StopLoading();
        }
    }

    private void StartLoading() => isLoading = true;

    private void StopLoading() => isLoading = false;
}