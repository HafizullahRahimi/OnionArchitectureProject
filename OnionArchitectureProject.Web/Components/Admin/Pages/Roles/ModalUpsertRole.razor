@using OnionArchitectureProject.Application.Admin.RoleService.Models.UpsertRoleDto

<ModalBase @ref="_modalRef">
    <EditForm Model="@_formModel" OnValidSubmit="OnSubmitForm">
        <div class="modal-header">
            <h5 class="modal-title">@(_modalMode == ModalMode.Add ? "Add Role" : "Edit Role")</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <FluentValidationValidator @ref="_fluentValidationValidator" />
            <ValidationSummary />

            <div class="mb-3">
                <label for="name" class="form-label">Name</label>
                <InputText id="name" @bind-Value="_formModel.Name" class="form-control" />
                <ValidationMessage For="@(() => _formModel.Name)" class="text-danger" />
            </div>

            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <InputTextArea id="description" @bind-Value="_formModel.Description" class="form-control" rows="3" />
                <ValidationMessage For="@(() => _formModel.Description)" class="text-danger" />
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            @if (_isLoading)
            {
                <button type="button" class="btn btn-success" disabled>
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    Saving...
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-save me-1"></i>Save
                </button>
            }
        </div>
    </EditForm>
</ModalBase>

@code {
    [Parameter]
    public EventCallback<UpsertRoleDto> OnRoleCreated { get; set; }

    [Parameter]
    public EventCallback<(string, UpsertRoleDto)> OnRoleUpdated { get; set; }

    private ModalBase? _modalRef;
    private UpsertRoleDto _formModel = new();
    private ModalMode _modalMode = ModalMode.Add;
    private FluentValidationValidator? _fluentValidationValidator;
    private bool _isLoading;
    private string? _roleId;

    private enum ModalMode
    {
        Add,
        Edit
    }

    public async Task OpenModalAsync()
    {
        try
        {
            _modalMode = ModalMode.Add;
            _formModel = new();
            if (_modalRef != null)
            {
                await _modalRef.OpenModalAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error opening modal: {ex.Message}");
        }
    }

    public async Task OpenModalAsync(string roleId, UpsertRoleDto upsertRoleDto)
    {
        try
        {
            _roleId = roleId;
            _modalMode = ModalMode.Edit;
            _formModel = upsertRoleDto;
            if (_modalRef != null)
            {
                await _modalRef.OpenModalAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error opening edit modal: {ex.Message}");
        }
    }

    public async Task CloseModalAsync()
    {
        try
        {
            _isLoading = false;
            _roleId = null;
            if (_modalRef != null)
            {
                await _modalRef.CloseModalAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error closing modal: {ex.Message}");
        }
    }

    private async Task OnSubmitForm()
    {
        if (_fluentValidationValidator == null) return;

        try
        {
            _isLoading = true;
            if (await _fluentValidationValidator.ValidateAsync())
            {
                if (_modalMode == ModalMode.Add)
                {
                    await OnRoleCreated.InvokeAsync(_formModel);
                }
                else if (_modalMode == ModalMode.Edit && !string.IsNullOrEmpty(_roleId))
                {
                    await OnRoleUpdated.InvokeAsync((_roleId, _formModel));
                }
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error during form submission: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }
}