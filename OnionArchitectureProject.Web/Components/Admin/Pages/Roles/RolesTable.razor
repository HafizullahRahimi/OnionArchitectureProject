@using OnionArchitectureProject.Application.Admin.RoleService.Models

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Created</th>
                <th>Created By</th>
                <th>Modified</th>
                <th>Modified By</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            <Virtualize Items="@Roles" Context="role">
                <tr>
                    <td>@role.Name</td>
                    <td>@role.CreatedLocalTime.ToString("g")</td>
                    <td>@role.CreatedByUserName</td>
                    @if (role.ModifiedLocalTime != DateTime.MinValue)
                    {
                        <td>@role.ModifiedLocalTime.ToString("g")</td>
                        <td>@role.ModifiedByUserName</td>
                    }
                    else
                    {
                        <td>-</td>
                        <td>-</td>
                    }
                    <td class="text-end">
                        <div class="btn-group" role="group">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="async () => await HandleEditRoleAsync(role)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="async () => await HandleDeleteRoleAsync(role)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            </Virtualize>
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public List<RoleDto> Roles { get; set; } = default!;
    [Parameter] public EventCallback<RoleDto> OnEditRole { get; set; }
    [Parameter] public EventCallback<RoleDto> OnDeleteRole { get; set; }

    private async Task HandleEditRoleAsync(RoleDto role)
    {
        if (OnEditRole.HasDelegate)
            await OnEditRole.InvokeAsync(role);
    }

    private async Task HandleDeleteRoleAsync(RoleDto role)
    {
        if (OnDeleteRole.HasDelegate)
            await OnDeleteRole.InvokeAsync(role);
    }
}