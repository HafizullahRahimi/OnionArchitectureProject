@page "/Admin/Roles"

@using OnionArchitectureProject.Application.Admin.RoleService
@using OnionArchitectureProject.Application.Admin.RoleService.Models
@using OnionArchitectureProject.Authentication.Models
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inherits OwningComponentBase<IRoleService>
@inject ILogger<Roles> Logger

<PageTitle>Roles Management</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fs-2 text-black mb-0">Roles Management</h1>
    <button type="button" class="btn btn-primary" @onclick="OpenUpsertModalAsync">
        <i class="bi bi-plus-circle"></i> Add Role
    </button>
</div>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 200px;">
        <Spinner />
    </div>
}
else if (roles?.Any() != true)
{
    <div class="alert alert-info" role="alert">
        <p>
            <i class="bi bi-info-circle me-2"></i>
            No roles available. Click the "Add Role" button to create one.
        </p>
    </div>
}
else
{
    <RolesTable Roles="roles" OnEditRole="OnEditRole" OnDeleteRole="OnDeleteRole" />
}

<ModalUpsertRole @ref="upsertModalRef" OnRoleCreated="OnRoleCreated" OnRoleUpdated="OnRoleUpdated" />
<RoleDeleteRestoreModal @ref="roleDeleteRestoreModalRef" OnConfirmed="OnConfirmed" />
<SweetAlert @ref="sweetAlertRef" ConfirmButtonText="Ok" />

@code {
    private List<RoleDto>? roles;
    private ModalUpsertRole? upsertModalRef;
    private RoleDeleteRestoreModal? roleDeleteRestoreModalRef;
    private SweetAlert? sweetAlertRef;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadRolesAsync();
    }

    private async Task LoadRolesAsync()
    {
        try
        {
            isLoading = true;
            roles = await Service.GetRolesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading roles");
            await ShowErrorAlert("Failed to load roles. Please try again.");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    #region Modal Management
    private async Task OpenUpsertModalAsync()
    {
        if (upsertModalRef != null)
            await upsertModalRef.OpenModalAsync();
    }

    private async Task OpenUpsertModalAsync(RoleDto roleDto)
    {
        if (upsertModalRef is null)
            return;

        var upsertRoleDto = Service.MapToUpsertRoleDto(roleDto);
        if (upsertRoleDto != null)
            await upsertModalRef.OpenModalAsync(upsertRoleDto);
    }

    private async Task CloseUpsertModalAsync()
    {
        if (upsertModalRef != null)
            await upsertModalRef.CloseModalAsync();
    }

    private async Task OpenDeleteRestoreModalAsync(DeleteRestoreMode modalMode, string roleName, string? message = null)
    {
        if (roleDeleteRestoreModalRef is null)
            return;

        if (message != null)
        {
            await roleDeleteRestoreModalRef.OpenModalAsync(modalMode, roleName, message);
        }
        else
        {
            await roleDeleteRestoreModalRef.OpenModalAsync(modalMode, roleName);
        }
    }

    private async Task CloseDeleteRestoreModalAsync()
    {
        if (roleDeleteRestoreModalRef != null)
            await roleDeleteRestoreModalRef.CloseModalAsync();
    }
    #endregion

    #region Role Operations
    private async Task OnEditRole(RoleDto roleDto)
    {
        await OpenUpsertModalAsync(roleDto);
    }

    private async Task OnDeleteRole(RoleDto roleDto)
    {
        await OpenDeleteRestoreModalAsync(DeleteRestoreMode.Delete, roleDto.Name);
    }

    private async Task OnRoleCreated(UpsertRoleDto upsertRoleDto)
    {
        var result = await Service.CreateAsync(upsertRoleDto);

        if (result.Succeeded)
        {
            await HandleRoleOperationAsync(async () =>
            {
                await LoadRolesAsync();
                await CloseUpsertModalAsync();
            }, $"Role '{upsertRoleDto.Name}' created successfully!");
        }
        else if (result.Error == "RoleDeleted")
        {
            await HandleDeletedRoleScenario(upsertRoleDto.Name);
        }
        else
        {
            await ShowWarningAlert(result.Error ?? "An error occurred while creating the role.");
        }
    }

    private async Task OnRoleUpdated(UpsertRoleDto upsertRoleDto)
    {
        var result = await Service.UpdateAsync(upsertRoleDto);

        if (result.Succeeded)
        {
            await HandleRoleOperationAsync(async () =>
            {
                await LoadRolesAsync();
                await CloseUpsertModalAsync();
            }, $"Role '{upsertRoleDto.Name}' updated successfully!");
        }
        else if (result.Error == "RoleDeleted")
        {
            await HandleDeletedRoleScenario(upsertRoleDto.Name);
        }
        else
        {
            Logger.LogError(result.Error, $"Error occurred while updating role {upsertRoleDto.Name}");
            await ShowWarningAlert(result.Error ?? "An error occurred while updating the role.");
        }
    }

    private async Task OnConfirmed((DeleteRestoreMode modalMode, string roleName) args)
    {
        var operation = args.modalMode == DeleteRestoreMode.Delete ?
        HandleRoleDelete(args.roleName) :
        HandleRoleRestore(args.roleName);

        await operation;
    }

    private async Task HandleRoleDelete(string roleName)
    {
        var result = await Service.DeleteAsync(roleName);
        if (result.Succeeded)
        {
            await HandleRoleOperationAsync(async () =>
            {
                await CloseDeleteRestoreModalAsync();
                await LoadRolesAsync();
            }, $"Role '{roleName}' deleted successfully!");
        }
        else
        {
            Logger.LogError(result.Error, $"Error occurred while deleting role {roleName}");
            await ShowErrorAlert("An error occurred while deleting the role.");
        }
    }

    private async Task HandleRoleRestore(string roleName)
    {
        var result = await Service.RestoreAsync(roleName);
        if (result.Succeeded)
        {
            await HandleRoleOperationAsync(async () =>
            {
                await CloseDeleteRestoreModalAsync();
                await LoadRolesAsync();
            }, $"Role '{roleName}' restored successfully!");
        }
        else
        {
            Logger.LogError(result.Error, $"Error occurred while restoring role {roleName}");
            await ShowErrorAlert("An error occurred while restoring the role.");
        }
    }

    private async Task HandleDeletedRoleScenario(string roleName)
    {
        await OpenDeleteRestoreModalAsync(
        DeleteRestoreMode.Restore,
        roleName,
        $"{roleName} is deleted. Do you want to restore it?");
        await CloseUpsertModalAsync();
    }
    #endregion

    #region Alert Management
    private async Task HandleRoleOperationAsync(Func<Task> operation, string successMessage)
    {
        await operation();
        await InvokeAsync(StateHasChanged);
        await ShowSuccessAlert(successMessage);
    }

    private async Task ShowSuccessAlert(string message) =>
    await ShowAlertAsync(message, SweetAlertIcon.Success);

    private async Task ShowWarningAlert(string message) =>
    await ShowAlertAsync(message, SweetAlertIcon.Warning);

    private async Task ShowErrorAlert(string message) =>
    await ShowAlertAsync(message, SweetAlertIcon.Error);

    private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
    {
        if (sweetAlertRef != null)
        {
            await sweetAlertRef.ShowAlertAsync(text, icon);
        }
    }
    #endregion
}