@using OnionArchitectureProject.Application.Admin.CategoryService.Models.UpsertCategoryDto
@using OnionArchitectureProject.Domain.Categories

<ModalUpsert @ref="modalRef" AddTitle="Add Category" EditTitle="Edit Category" FormModel="@formModel"
    OnCreated="OnCategoryCreated" OnUpdated="OnCategoryUpdated">
    <div class="mt-2">
        <label for="name" class="form-label">Name:</label>
        <InputText id="name" @bind-Value="formModel.Name" class="form-control" />
        <ValidationMessage For="@(() => formModel.Name)"></ValidationMessage>
    </div>
</ModalUpsert>

@code {
    [Parameter]
    public EventCallback<UpsertCategoryDto> OnCategoryCreated { get; set; }
    [Parameter]
    public EventCallback<UpsertCategoryDto> OnCategoryUpdated { get; set; }

    private ModalUpsert<UpsertCategoryDto>? modalRef;
    private UpsertCategoryDto formModel = new();

    public async Task OpenModalAsync()
    {
        formModel = new();
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync();
        }
    }

    public async Task OpenModalAsync(UpsertCategoryDto upsertCategoryDto)
    {
        formModel = upsertCategoryDto;
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync(formModel);
        }
    }

    public async Task CloseModalAsync()
    {
        if (modalRef != null)
        {
            await modalRef.CloseModalAsync();
        }
    }
}