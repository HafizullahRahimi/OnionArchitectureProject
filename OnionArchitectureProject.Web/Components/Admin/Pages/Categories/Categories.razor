@page "/Admin/Categories"

@using Microsoft.AspNetCore.Authentication
@using OnionArchitectureProject.Application.Admin.CategoryService
@using OnionArchitectureProject.Application.Admin.CategoryService.Models
@using OnionArchitectureProject.Application.Admin.CategoryService.Models.UpsertCategoryDto
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert
@using System.Diagnostics

@inject ICategoryService CategoryService
@inject ILogger<Categories> Logger

<PageTitle>Categories</PageTitle>

<div>
    <button type="button" class="btn btn-success float-end me-3" @onclick=OpenCategoryModal>Add category</button>
    <h1 class="fs-2 text-black">Categories</h1>
</div>

@if (categories == null)
{
    <Spinner />
}
else if (!categories.Any())
{
    <div>No categories available.</div>
}
else
{
    <table class="table table-striped caption-top">
        <thead>
            <tr>
                <th>Name</th>
                <th>CreatedAt</th>
                <th>CreatedBy</th>
                <th>ModifiedBy</th>
                <th>Settings</th>
            </tr>
        </thead>
        <tbody>
            <Virtualize Items="@categories" Context="category">
                <tr>
                    <td>@category.Name</td>
                    <td>@category.CreatedAt</td>
                    <td>@category.CreatedByUserName</td>
                    <td>@category.ModifiedByUserName</td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary me-2" @onclick=@(()=>OpenCategoryModal(category))>Edit</a> |
                        <a class="btn btn-sm btn-outline-success mx-2">Details</a> |
                        <a class="btn btn-sm btn-outline-danger ms-2" @onclick=@(()=>OpenDeleteModal(category))>Delete</a>
                    </td>
                </tr>
            </Virtualize>
        </tbody>
    </table>
}

<ModalUpsetCategory @ref=categoryModalRef OnCategoryCreated="OnCategoryCreated" OnCategoryUpdated="OnCategoryUpdated" />
<ModalDeleteCategory @ref=deleteModalRef OnCategoryDeleted="OnCategoryDeleted" />
<SweetAlert @ref=sweetAlertRef ConfirmButtonText="Ok" />

@code {
    private ModalUpsetCategory? categoryModalRef;
    private ModalDeleteCategory? deleteModalRef;
    private List<CategoryDto>? categories;
    private SweetAlert? sweetAlertRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task OpenCategoryModal()
    {
        if (categoryModalRef != null)
        {
            await categoryModalRef.OpenModalAsync();
        }
    }

    private async Task OpenCategoryModal(CategoryDto categoryDto)
    {
        if (categoryModalRef != null)
        {
            var category = CategoryService.MapToUpsertCategoryDto(categoryDto);

            if (category != null)
            {
                await categoryModalRef.OpenModalAsync(category);
            }
        }
    }

    private async Task CloseCategoryModal()
    {
        if (categoryModalRef != null)
        {
            await categoryModalRef.CloseModalAsync();
        }
    }

    private async Task OnCategoryCreated(UpsertCategoryDto categoryDto)
    {
        try
        {
            var categoryId = await CategoryService.CreateAsync(categoryDto, CancellationToken.None);
            if (categoryId != Guid.Empty)
            {
                await LoadCategoriesAsync();
                await InvokeAsync(StateHasChanged);
                await CloseCategoryModal();
                await ShowAlertAsync($"Category created successfully!", SweetAlertIcon.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message, "Error creating category.");
        }
    }

    private async Task OnCategoryUpdated(UpsertCategoryDto category)
    {
        try
        {
            var categoryUpdated = await CategoryService.UpdateAsync(category, CancellationToken.None);
            if (categoryUpdated)
            {
                await LoadCategoriesAsync();
                await InvokeAsync(StateHasChanged);
                await CloseCategoryModal();
                await ShowAlertAsync($"Category {category.Name} updated successfully!", SweetAlertIcon.Success);
            }
            else
            {
                await ShowAlertAsync($"Category '{category.Name}' not found!", SweetAlertIcon.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message, "Error updating category.");
        }
    }

    private async Task OpenDeleteModal(CategoryDto category)
    {
        if (deleteModalRef != null)
        {
            await deleteModalRef.OpenModalAsync(category);
        }
    }

    private async Task OnCategoryDeleted(CategoryDto category)
    {
        if (category.Id == Guid.Empty)
        {
            await ShowAlertAsync("Category not found!.", SweetAlertIcon.Error);
            return;
        }

        try
        {
            await CategoryService.DeleteAsync(category.Id, CancellationToken.None);
            await LoadCategoriesAsync();
            await InvokeAsync(StateHasChanged);
            await ShowAlertAsync($"Category '{category.Name}' deleted successfully!", SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex.Message, "Error deleting category.");
        }
    }

    private async Task LoadCategoriesAsync()
    {
        Stopwatch stopwatch = Stopwatch.StartNew();
        categories = await CategoryService.GetCategoriesAsync(CancellationToken.None);
        stopwatch.Stop();
        Logger.LogInformation($"Query executed in: {stopwatch.ElapsedMilliseconds} ms");
    }

    private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
    {
        if (sweetAlertRef != null)
        {
            await sweetAlertRef.ShowAlertAsync(text, icon);
        }
    }
}