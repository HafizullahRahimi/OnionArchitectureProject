@page "/Admin/Categories"

@using Microsoft.AspNetCore.Authentication
@using OnionArchitectureProject.Application.Admin.CategoryService
@using OnionArchitectureProject.Application.Admin.CategoryService.Models
@using OnionArchitectureProject.Application.Admin.CategoryService.Models.UpsertCategoryDto
@using OnionArchitectureProject.Web.Components.Shared.SweetAlert
@using System.Diagnostics

@inherits OwningComponentBase<ICategoryService>
@inject ILogger<Categories> Logger

<PageTitle>Categories</PageTitle>

<div>
    <button type="button" class="btn btn-success float-end me-3" @onclick=OpenUpsertModal>Add category</button>
    <h1 class="fs-2 text-black">Categories</h1>
</div>

@if (categories == null)
{
    <Spinner />
}
else if (!categories.Any())
{
    <div>No categories available.</div>
}
else
{
    <table class="table table-striped caption-top">
        <thead>
            <tr>
                <th>Name</th>
                <th>Created(LocalTime)</th>
                <th>CreatedBy</th>
                <th>Modified(LocalTime)</th>
                <th>ModifiedBy</th>
                <th>Settings</th>
            </tr>
        </thead>
        <tbody>
            <Virtualize Items="@categories" Context="category">
                <tr>
                    <td>@category.Name</td>
                    <td>@category.CreatedLocalTime</td>
                    <td>@category.CreatedByUserName</td>
                    @if (@category.ModifiedLocalTime != DateTime.MinValue) 
                    {
                        <td>@category.ModifiedLocalTime</td>
                        <td>@category.ModifiedByUserName</td>
                    }
                    else
                    {
                        <td>-</td>
                        <td>-</td>
                    }
                    <td>
                        <a class="btn btn-sm btn-outline-primary me-2" @onclick=@(()=>OpenUpsertModal(category))>Edit</a> |
                        <a class="btn btn-sm btn-outline-success mx-2">Details</a> |
                        <a class="btn btn-sm btn-outline-danger ms-2" @onclick=@(()=>OpenDeleteModal(category))>Delete</a>
                    </td>
                </tr>
            </Virtualize>
        </tbody>
    </table>
}

<ModalUpsertCategory @ref=upsertModalRef OnCategoryCreated="OnCategoryCreated" OnCategoryUpdated="OnCategoryUpdated" />
<ModalDeleteCategory @ref=deleteModalRef OnCategoryDeleted="OnCategoryDeleted" />
<SweetAlert @ref=sweetAlertRef ConfirmButtonText="Ok" />

@code {
    private ModalUpsertCategory? upsertModalRef;
    private ModalDeleteCategory? deleteModalRef;
    private List<CategoryDto>? categories;
    private SweetAlert? sweetAlertRef;

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
    }

    private async Task OpenUpsertModal()
    {
        if (upsertModalRef != null)
        {
            await upsertModalRef.OpenModalAsync();
        }
    }

    private async Task OpenUpsertModal(CategoryDto categoryDto)
    {
        if (upsertModalRef != null)
        {
            var upsertCategoryDto = Service.MapToUpsertCategoryDto(categoryDto);

            if (upsertCategoryDto != null)
            {
                await upsertModalRef.OpenModalAsync(upsertCategoryDto);
            }
        }
    }

    private async Task CloseUpsertModal()
    {
        if (upsertModalRef != null)
        {
            await upsertModalRef.CloseModalAsync();
        }
    }

    private async Task OnCategoryCreated(UpsertCategoryDto upsertCategoryDto)
    {
        await HandleCategoryOperationAsync(async () =>
        {
            var categoryCreated = await Service.CreateAsync(upsertCategoryDto, CancellationToken.None);
            if (categoryCreated)
            {
                await LoadCategoriesAsync();
                await CloseUpsertModal();
            }
            else
            {
                throw new Exception("Failed to create category.");
            }
        }, "Category created successfully!");
    }

    private async Task OnCategoryUpdated(UpsertCategoryDto upsertCategoryDto)
    {
        if (upsertCategoryDto.Id == Guid.Empty)
        {
            await ShowAlertAsync($"Category '{upsertCategoryDto.Name}' not found!", SweetAlertIcon.Error);
            return;
        }

        await HandleCategoryOperationAsync(async () =>
        {
            var categoryUpdated = await Service.UpdateAsync(upsertCategoryDto, CancellationToken.None);
            if (categoryUpdated)
            {
                await LoadCategoriesAsync();
                await CloseUpsertModal();
            }
            else
            {
                throw new Exception($"Category '{upsertCategoryDto.Name}' not found!");
            }
        }, $"Category {upsertCategoryDto.Name} updated successfully!");
    }

    private async Task OpenDeleteModal(CategoryDto categoryDto)
    {
        if (deleteModalRef != null)
        {
            await deleteModalRef.OpenModalAsync(categoryDto);
        }
    }

    private async Task OnCategoryDeleted(CategoryDto categoryDto)
    {
        if (categoryDto.Id == Guid.Empty)
        {
            await ShowAlertAsync("Category not found!.", SweetAlertIcon.Error);
            return;
        }

        await HandleCategoryOperationAsync(async () =>
        {
            var categoryDeleted = await Service.DeleteAsync(categoryDto.Id, CancellationToken.None);
            if (categoryDeleted)
            {
                await LoadCategoriesAsync();
            }
            else
            {
                throw new Exception($"Failed to delete category '{categoryDto.Name}'.");
            }

        }, $"Category '{categoryDto.Name}' deleted successfully!");
    }

    private async Task HandleCategoryOperationAsync(Func<Task> operation, string successMessage)
    {
        try
        {
            await operation();
            await InvokeAsync(StateHasChanged);
            await ShowAlertAsync(successMessage, SweetAlertIcon.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError($"An error occurred: {ex.Message}");
        }
    }

    private async Task LoadCategoriesAsync()
    {
        categories = await Service.GetCategoriesAsync(CancellationToken.None);
    }

    private async Task ShowAlertAsync(string text, SweetAlertIcon icon)
    {
        if (sweetAlertRef != null)
        {
            await sweetAlertRef.ShowAlertAsync(text, icon);
        }
    }
}