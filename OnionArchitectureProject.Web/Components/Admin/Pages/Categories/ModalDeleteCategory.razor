@using OnionArchitectureProject.Application.Admin.CategoryService.Models

<ModalDelete @ref="deleteModal" Title="Delete category" OnDeleted="HandleDeleted">
	<div class="alert alert-warning">
		<p>
			<i class="bi bi-exclamation-triangle me-2"></i>
			Are you sure you want to delete the <strong>@categoryToDelete.Name</strong>?
		</p>
		<p class="mb-0 mt-2">
			<i class="bi bi-exclamation-circle me-2"></i>
			<strong>Warning:</strong> This will also delete all products associated with this category.
		</p>
		<p class="mb-0 mt-2 text-muted small">This action cannot be undone.</p>
	</div>
</ModalDelete>

@code {
	[Parameter]
	public EventCallback<CategoryDto> OnCategoryDeleted { get; set; }

	private ModalDelete? deleteModal;
	private CategoryDto categoryToDelete = new();

	public async Task OpenModalAsync(CategoryDto category)
	{
		categoryToDelete = category;
		if (deleteModal != null)
		{
			await deleteModal.OpenModalAsync();
		}
	}

	public async Task CloseModalAsync()
	{
		if (deleteModal != null)
		{
			await deleteModal.CloseModalAsync();
		}
	}

	private async Task HandleDeleted()
	{
		await OnCategoryDeleted.InvokeAsync(categoryToDelete);
	}
}