@rendermode InteractiveServer

@using AutoMapper
@using OnionArchitectureProject.Application.Services.CategoryService.Models.CategoryDto
@using OnionArchitectureProject.Domain.Categories

@inject IMapper mapper

<ModalBase @ref=modalRef>
    <EditForm Model="@formModel" Enhance=true OnValidSubmit="OnSubmitForm">
        <div class="modal-header">
            <h5 class="modal-title">@((modalMode == "add") ? "Add category" : "Edit category")</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <FluentValidationValidator @ref="_fluentValidationValidator" />
            <ValidationSummary />
            <div class="mt-2">
                <label for="name" class="form-label">Name:</label>
                <InputText id="name" @bind-Value="formModel.Name" class="form-control" />
                <ValidationMessage For="@(()=>formModel.Name)"></ValidationMessage>
            </div>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            @if (isLoading)
            {
                <Spinner Title="Saving" TextColor="text-light" BgColor="bg-success" />
            }
            else
            {
                <button type="submit" class="btn btn-success ">Save</button>
            }
        </div>
    </EditForm>
</ModalBase>

@code {
    [Parameter]
    public EventCallback<CategoryDto> OnCategoryCreated { get; set; }
    [Parameter]
    public EventCallback<Category> OnCategoryUpdated { get; set; }

    private ModalBase? modalRef;
    private string modalMode = "add";
    private CategoryDto formModel = new();
    private FluentValidationValidator? _fluentValidationValidator;
    private bool isLoading = false;
    private Category? categoryToUpdate;

    public async Task OpenModalAsync()
    {
        modalMode = "add";
        formModel = new();
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync();
        }
    }

    public async Task OpenModalAsync(Category category)
    {
        modalMode = "update";
        categoryToUpdate = category;
        formModel = mapper.Map<CategoryDto>(category);
        if (modalRef != null)
        {
            await modalRef.OpenModalAsync();
        }
    }

    public async Task CloseModalAsync()
    {
        StopLoading();
        if (modalRef != null)
        {
            await modalRef.CloseModalAsync();
        }
    }

    private async Task OnSubmitForm()
    {
        StartLoading();
        try
        {
            if (await _fluentValidationValidator!.ValidateAsync())
            {
                if (modalMode == "add")
                {
                    await OnCategoryCreated.InvokeAsync(formModel);
                }
                else if (modalMode == "update" && categoryToUpdate != null)
                {
                    categoryToUpdate = mapper.Map<Category>(formModel);
                    await OnCategoryUpdated.InvokeAsync(categoryToUpdate);
                }
                // await CloseModalAsync();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error during form submission: {ex.Message}");
        }
        finally
        {
            StopLoading();
        }
    }

    private void StartLoading() => isLoading = true;

    private void StopLoading() => isLoading = false;
}