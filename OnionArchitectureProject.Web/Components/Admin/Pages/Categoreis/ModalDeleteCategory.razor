@using OnionArchitectureProject.Domain.Categories

<ModalBase @ref="modalRef">
    <div class="modal-header">
        <h1 class="modal-title fs-5">Delete Category</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        Are you sure you want to delete the category: <strong>@categoryToDelete.Name</strong>?
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" data-bs-dismiss="modal" @onclick="DeleteCategory">Delete</button>
    </div>
</ModalBase>

@code {
    [Parameter]
    public EventCallback<Category> OnCategoryDeleted { get; set; }

    private ModalBase? modalRef;
    private Category categoryToDelete = new();

    public async Task OpenModalAsync(Category category)
    {
        if (modalRef != null)
        {
            // await Task.Delay(5000);
            // Console.WriteLine($"Category: {category.Name} ");
            // StateHasChanged(); // Force update to ensure the UI binds to the new value
            categoryToDelete = category;
            await InvokeAsync(StateHasChanged);
            await modalRef.OpenModalAsync();
        }

    }

    public async Task CloseModalAsync()
    {
        if (modalRef != null)
        {
            await modalRef.CloseModalAsync();
        }
    }

    private async Task DeleteCategory()
    {
        if (categoryToDelete != null)
        {
            await OnCategoryDeleted.InvokeAsync(categoryToDelete);
        }
    }
}
