@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <Sidebar />
    </div>
    <main>
        <div class="top-row px-4">
            <!-- User Menu -->
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center  text-decoration-none dropdown-toggle text-black" data-bs-toggle="dropdown" aria-expanded="false">
                    <img src="/images/user.png" alt="" width="32" height="32" class="rounded-circle me-2">
                    User Name
                </a>
                <ul class="dropdown-menu text-small shadow">
                    <li><a class="dropdown-item" href="#">Profile</a></li>
                    <li><a class="dropdown-item" href="#">Settings</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item text-danger" href="#">Sign out</a></li>
                </ul>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
