
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
@if (Text != null)
{
    <script>
        Swal.fire({
            title: "@Title",
            text: "@Text",
            icon: "@Icon"
        });
    </script>
}
else
{
    <script>
        Swal.fire({
            position: "top-end",
            icon: "@Icon",
            title: "@Title",
            showConfirmButton: false,
            timer: 1500,
        });
    </script>
}

@code {
    [Parameter] public string Title { get; set; }
    [Parameter] public string Text { get; set; } = null;
    [Parameter] public string Icon { get; set; } = "success";
}