@page "/SweetAlertTest"
@rendermode InteractiveServer

@using OnionArchitectureProject.Web.Components.Shared.SweetAlert

@inject ILogger<SweetAlertTest> Logger

<h3>SweetAlert Test</h3>

<!-- Simple Alert with Ref -->
<button class="btn btn-primary" @onclick="ShowAlertAsync">CLick me! </button>
<SweetAlert @ref=SweetAlertRef ConfirmButtonText="Ok" />
<br />

<!-- Simple Alert -->
<SweetAlert Text="This is an informational alert!"
            ConfirmButtonText="Got It">
    <button class="btn btn-primary">Show Info Alert</button>
</SweetAlert>
<br />

<!-- Question Alert -->
<SweetAlert Title="Delete Confirmation"
            Text="Are you sure you want to delete this?"
            Icon="SweetAlertIcon.Question"
            ShowCancelButton="true"
            ConfirmButtonText="Yes, Delete"
            CancelButtonText="No, Cancel"
            OnConfirm="HandleConfirm"
            OnCancel="HandleCancel">
    <button class="btn btn-danger">Show Confirmation Alert</button>
</SweetAlert>

@code {
    private SweetAlert? SweetAlertRef;

    private void HandleConfirm()
    {
        Logger.LogInformation("Confirmed action at {Time}", DateTime.Now);
    }

    private void HandleCancel()
    {
        Logger.LogWarning("Action canceled at {Time}", DateTime.Now);
    }


    private async Task ShowAlertAsync()
    {
        if (SweetAlertRef != null)
        {
            Logger.LogError("Showing alert at {Time}", DateTime.Now);
            await SweetAlertRef.ShowAlertAsync("ddddd", SweetAlertIcon.Error);
        }
    }
}
